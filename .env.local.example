# Pluggy API credentials — create a developer account at https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Free "Meu Pluggy" tier: GET /items may return 403, so item ids are configured by hand.
# Connect your banks at https://meu.pluggy.ai and paste the item id(s) here, comma-separated.
PLUGGY_ITEM_IDS=

# Optional: names of the clients that pay your PJ revenue, comma-separated. Seeds a
# high-priority "Receita PJ" rule so income is never caught by a generic transfer
# heuristic. Kept out of the repo because these are real counterparties.
PJ_PAYERS=

# Optional: override the SQLite location (defaults to ./db/finance.db)
# FINANCE_DB_PATH=
